# Copy this file to .env.local and fill in real values there — .env.local
# is gitignored, this example file is not.

# Used by app/api/feedback/route.ts to file the feedback control's
# submissions as GitHub issues on Langbra24/loupe, server-side. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix). Full steps, including
# the Vercel side: "Feedback setup" in the root README.md.
#
# Create a fine-grained personal access token at
# https://github.com/settings/personal-access-tokens/new scoped to:
#   - Repository access: only this repo (Langbra24/loupe)
#   - Permissions: Issues -> Read and write (nothing else needed)
#
# Note: if this token belongs to the repo owner's own account, GitHub does
# not send a notification for issues that account's own token files (same
# as not emailing yourself for your own actions) — use a separate
# lightweight bot account's token instead if you want an email per
# submission.
GITHUB_FEEDBACK_TOKEN=

# Leave unset. Only scripts/verify/feedback.mjs sets it, to point the route
# at a local stand-in for GitHub. Defaults to https://api.github.com.
# GITHUB_API_URL=

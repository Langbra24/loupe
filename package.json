{
  "name": "loupe",
  "version": "0.0.1",
  "private": true,
  "description": "Browser-based photobook/zine layout tool — sequence, design, and print-impose a booklet.",
  "license": "MIT",
  "workspaces": [
    "core",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/verify/**/*.test.mjs\"",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "screenshot": "npm run build && node scripts/verify/screenshot.mjs",
    "e2e": "npm run build && node scripts/verify/e2e-export.mjs",
    "verify:rename": "npm run build && node scripts/verify/rename.mjs",
    "verify:feedback": "npm run build && node scripts/verify/feedback.mjs",
    "verify:text-selection": "LOUPE_TEST_HOOKS=1 npm run build && node scripts/verify/text-selection.mjs",
    "verify:picker-focus": "npm run build && node scripts/verify/color-picker-focus.mjs",
    "verify:frame-cycling": "LOUPE_TEST_HOOKS=1 npm run build && node scripts/verify/frame-cycling.mjs"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.1"
  }
}
